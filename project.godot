; DEADLANE: ZOMBIE BRIDGE
; Pinned for Godot 4.7.2-stable
config_version=5

[application]
config/name="DEADLANE: ZOMBIE BRIDGE"
config/description="Portrait 3D zombie bridge defense shooter"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/icon.png"
config/version="1.5.1"
config/quit_on_go_back=false

[autoload]
GameState="*res://scripts/core/game_state.gd"
SaveManager="*res://scripts/core/save_manager.gd"
AudioManager="*res://scripts/core/audio_manager.gd"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048

[physics]
common/physics_ticks_per_second=60
